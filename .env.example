# Copy to .env at the repo root, then adjust. Both apps and docker-compose
# read this one file: a variable that appears twice is a variable that will
# eventually disagree with itself.
#
#   cp .env.example .env
#
# Values below are development defaults. Every secret here is throwaway and
# must be regenerated for any deployment - see "Generating secrets" at the
# bottom of this file.

# ─────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────
# apps/server (Fastify JSON API, port 3001)
# ─────────────────────────────────────────────────────────────────────────

# Interface the API binds to. 127.0.0.1 keeps it off the LAN; set 0.0.0.0
# when testing from a second device (checkpoint C in task 2.7).
HOST=127.0.0.1
PORT=3001

# Exact origin of apps/web, used as the CORS allowlist and checked on the
# Origin header of every mutating request. No wildcard, no trailing slash.
# HTTPS because the session cookie is SameSite=None; Secure.
WEB_ORIGIN=https://localhost:3000

# Signs the session cookie. At least 32 characters.
SESSION_SECRET=dev-only-session-secret-change-me-0000

# ─────────────────────────────────────────────────────────────────────────
# apps/web (Next.js UI, port 3000)
# ─────────────────────────────────────────────────────────────────────────
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time.
# Anything under this heading is public. Never move a secret here.

# Where the browser reaches apps/server.
NEXT_PUBLIC_API_URL=https://localhost:3001

# Where the browser opens the LiveKit signalling WebSocket. wss:// once the
# SFU sits behind TLS.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ─────────────────────────────────────────────────────────────────────────
# PostgreSQL (task 2.12) and Prisma
# ─────────────────────────────────────────────────────────────────────────

POSTGRES_USER=chat
POSTGRES_PASSWORD=chat-dev-password
POSTGRES_DB=chat

# Consumed by Prisma and by the repositories in group 3. Host is `localhost`
# from the host machine and `postgres` from inside the Compose network.
DATABASE_URL=postgresql://chat:chat-dev-password@localhost:5432/chat?schema=public

# ─────────────────────────────────────────────────────────────────────────
# Redis (task 2.4)
# ─────────────────────────────────────────────────────────────────────────
#
# Two consumers: LiveKit room state, and the auth rate limiter in task 4.7.

REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────
# LiveKit SFU (task 2.1)
# ─────────────────────────────────────────────────────────────────────────

# Server-side only. LIVEKIT_API_SECRET signs the access tokens; if it ever
# reaches the browser, any visitor can mint a token for any room. Task 5.5
# asserts its absence from the client bundle.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-000000000000000000

# ─────────────────────────────────────────────────────────────────────────
# Coturn (task 2.8)
# ─────────────────────────────────────────────────────────────────────────

TURN_SHARED_SECRET=dev-only-turn-secret-change-me-00000
TURN_REALM=localhost

# ─────────────────────────────────────────────────────────────────────────
# Local HTTPS (task 1.10)
# ─────────────────────────────────────────────────────────────────────────
#
# Cross-site cookies require Secure, and Secure requires TLS even on
# localhost. Run `pnpm certs` to generate these with mkcert. Leave both
# empty to run apps/server over plain HTTP, which works for curl but breaks
# the browser session flow.

HTTPS_KEY_FILE=./certs/localhost-key.pem
HTTPS_CERT_FILE=./certs/localhost.pem

# ─────────────────────────────────────────────────────────────────────────
# Generating secrets
# ─────────────────────────────────────────────────────────────────────────
#
#   openssl rand -base64 32
#
# Applies to SESSION_SECRET, LIVEKIT_API_SECRET and TURN_SHARED_SECRET.
