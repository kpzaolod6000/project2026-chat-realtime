{
  "compilerOptions": {
    "target": "ES2022",
    // No "dom": this package is consumed by both the Node API and the
    // browser, so reaching for a DOM global must be a compile error here.
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    // Lets "go to definition" in consumers land on src/*.ts instead of
    // the generated dist/*.d.ts.
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
