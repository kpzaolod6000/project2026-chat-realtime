{
  "extends": "@chat/config/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    // The Prisma 7 generator emits TypeScript whose relative imports carry
    // explicit .ts extensions. These two flags let tsc accept those imports
    // and rewrite them to .js on emit, so dist/ is runnable by plain node.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
