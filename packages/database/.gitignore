# dependencies
node_modules

# Keep environment variables out of version control
.env

# build output
dist
*.tsbuildinfo

# turborepo task logs and local cache
.turbo

# Generated by `prisma generate`. Must stay ignored: turbo excludes
# gitignored files from a task's input hash, and without that the generator's
# own output would invalidate the build cache on every run.
/src/generated/prisma
